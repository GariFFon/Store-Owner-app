+                              style: const TextStyle(
+                                  color: Color(0xFF94A3B8), fontSize: 13),
+                            ),
+                            items: _racks
+                                .map((r) => DropdownMenuItem<String?>(
+                                      value: r['id']?.toString(),
+                                      child: Text(
+                                        r['name']?.toString() ?? '—',
