+                                ? null
+                                : (v) =>
+                                    setState(() => _selectedRackId = v),
+                          ),
+                    const SizedBox(height: 4),
+                    const Text(
+                      'Select a godown first.',
+                      style: TextStyle(
+                          fontSize: 11, color: Color(0xFF94A3B8)),
+                    ),
+
