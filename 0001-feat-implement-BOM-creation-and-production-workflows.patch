+              child: Row(
+                children: [
+                  const Text(
+                    'Execute Production',
+                    style: TextStyle(
+                      fontSize: 20,
+                      fontWeight: FontWeight.w800,
+                      color: Color(0xFF1E293B),
+                    ),
+                  ),
+                  const Spacer(),
+                  IconButton(
+                    icon: const Icon(Icons.close, size: 20),
+                    onPressed:
+                        _producing ? null : () => Navigator.of(context).pop(),
+                    style: IconButton.styleFrom(
+                        foregroundColor: const Color(0xFF64748B)),
+                  ),
+                ],
+              ),
+            ),
+            const Divider(height: 16, indent: 20, endIndent: 20),
+
+            // ── Scrollable body ───────────────────────────────────────────
+            Flexible(
+              child: SingleChildScrollView(
+                padding: const EdgeInsets.fromLTRB(20, 4, 20, 4),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    // Quantity Multiplier
+                    TextField(
+                      controller: _qtyController,
+                      keyboardType: TextInputType.number,
+                      decoration: InputDecoration(
+                        labelText: 'Quantity Multiplier',
+                        labelStyle: const TextStyle(
+                            fontSize: 13, color: Color(0xFF64748B)),
+                        border: OutlineInputBorder(
+                            borderRadius: BorderRadius.circular(8)),
+                        focusedBorder: OutlineInputBorder(
+                          borderRadius: BorderRadius.circular(8),
+                          borderSide: const BorderSide(
+                              color: Color(0xFF2563EB), width: 2),
+                        ),
+                        contentPadding: const EdgeInsets.symmetric(
+                            horizontal: 14, vertical: 14),
+                      ),
+                    ),
+                    const SizedBox(height: 4),
+                    const Text(
+                      'Scales all component requirements proportionally.',
+                      style: TextStyle(
+                          fontSize: 11, color: Color(0xFF94A3B8)),
+                    ),
+                    const SizedBox(height: 16),
+
+                    // Godown dropdown
+                    _godownsLoading
+                        ? const Center(
+                            child: Padding(
+                              padding: EdgeInsets.symmetric(vertical: 14),
+                              child:
+                                  CircularProgressIndicator(strokeWidth: 2),
+                            ),
+                          )
+                        : DropdownButtonFormField<String?>(
+                            initialValue: _selectedGodownId,
+                            isExpanded: true,
+                            decoration: InputDecoration(
+                              labelText: 'Select Godown',
+                              labelStyle: const TextStyle(
+                                  fontSize: 13, color: Color(0xFF64748B)),
+                              border: OutlineInputBorder(
+                                  borderRadius: BorderRadius.circular(8)),
+                              focusedBorder: OutlineInputBorder(
+                                borderRadius: BorderRadius.circular(8),
+                                borderSide: const BorderSide(
+                                    color: Color(0xFF2563EB), width: 2),
+                              ),
+                              contentPadding: const EdgeInsets.symmetric(
+                                  horizontal: 14, vertical: 14),
+                            ),
+                            hint: const Text('Select Godown'),
+                            items: _godowns
+                                .map((g) => DropdownMenuItem<String?>(
+                                      value: g['id']?.toString(),
+                                      child: Text(
+                                        g['name']?.toString() ?? '—',
+                                        overflow: TextOverflow.ellipsis,
+                                      ),
+                                    ))
+                                .toList(),
+                            onChanged: (v) {
+                              setState(() {
+                                _selectedGodownId = v;
+                                _racks = [];
+                                _selectedRackId = null;
+                              });
+                              if (v != null) _loadRacks(v);
+                            },
+                          ),
+                    const SizedBox(height: 4),
+                    const Text(
+                      'Where production output will be stored.',
+                      style: TextStyle(
+                          fontSize: 11, color: Color(0xFF94A3B8)),
+                    ),
+                    const SizedBox(height: 16),
+
+                    // Rack dropdown
+                    _racksLoading
+                        ? const Center(
+                            child: Padding(
+                              padding: EdgeInsets.symmetric(vertical: 14),
+                              child:
+                                  CircularProgressIndicator(strokeWidth: 2),
+                            ),
+                          )
+                        : DropdownButtonFormField<String?>(
+                            initialValue: _selectedRackId,
+                            isExpanded: true,
+                            decoration: InputDecoration(
+                              labelText: 'Select Rack',
+                              labelStyle: const TextStyle(
+                                  fontSize: 13,
+                                  color: Color(0xFF64748B)),
+                              border: OutlineInputBorder(
+                                  borderRadius: BorderRadius.circular(8)),
+                              focusedBorder: OutlineInputBorder(
+                                borderRadius: BorderRadius.circular(8),
+                                borderSide: const BorderSide(
+                                    color: Color(0xFF2563EB), width: 2),
+                              ),
